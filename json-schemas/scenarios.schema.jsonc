{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "patternProperties": {
        "^[a-z](?:[a-z0-9\\-]*[a-z0-9])?$": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "description",
                "durationSeconds",
                "repetitions",
                "receiverConsumptionMbps",
                "paths"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string"
                },
                "durationSeconds": {
                    "type": "number",
                    "minimum": 0.0
                },
                "repetitions": {
                    "type": "integer",
                    "minimum": 1
                },
                "receiverConsumptionMbps": {
                    "type": "number",
                    "minimum": 0.0
                },
                "paths": {
                    "type": "array",
                    "minItems": 1,
                    
                    "items": {
                        "uniqueItems": true,
                        "type": "object",
                        "required": [
                            "name",
                            "bandwidthMbps",
                            "delayMs",
                            "jitterMs",
                            "packetLossPercent"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "bandwidthMbps": {
                                "type": "number",
                                "minimum": 0.0
                            },
                            "delayMs": {
                                "type": "number",
                                "minimum": 0.0
                            },
                            "jitterMs": {
                                "type": "number",
                                "minimum": 0.0
                            },
                            "packetLossPercent": {
                                "type": "number",
                                "minimum": 0.0,
                                "maximum": 1.0
                            }
                        }
                    }
                }
            }
        }
    }
}