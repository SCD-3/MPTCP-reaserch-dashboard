{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "patternProperties": {
        "^[a-z](?:[a-z0-9\\-]*[a-z0-9])?$": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "code",
                "name",
                "shortName",
                "type",
                "description",
                "isActive",
                "parameters",
                "supportedEnvironments"
            ],
            "properties": {
                "code": {
                    "type": "string",
                    "pattern": "^[a-z]{3}$"
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "shortName": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "REFERENCE",
                        "AUTHORIAL"
                    ]
                },
                "description": {
                    "type": "string"
                },
                "isActive": {
                    "type": "boolean"
                },
                "parameters": {
                    "type": "object",
                    "additionalProperties": false,
                    "patternProperties": {
                        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
                            "type": "number"
                        }
                    }
                },
                "supportedEnvironments": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z](?:[a-z0-9\\-]*[a-z0-9])?$"
                    }
                }
            }
        }
    }
}