{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "patternProperties": {
        "^[a-z](?:[a-z0-9\\-]*[a-z0-9])?$": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "scenarioId",
                "environmentId",
                "algorithmIds",
                "repetitions",
                "status"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "scenarioId": {
                    "type": "string",
                    "pattern": "^[a-z](?:[a-z0-9\\-]*[a-z0-9])?$"
                },
                "environmentId": {
                    "type": "string",
                    "pattern": "^[a-z](?:[a-z0-9\\-]*[a-z0-9])?$"
                },
                "algorithmIds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z](?:[a-z0-9\\-]*[a-z0-9])?$"
                    }
                },
                "repetitions": {
                    "type": "integer",
                    "minimum": 1
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "DRAFT",
                        "PLANNED",
                        "QUEUED",
                        "RUNNING",
                        "COMPLETED",
                        "FAILED",
                        "CANCELLED"
                    ]
                }
            }
        }
    }
}