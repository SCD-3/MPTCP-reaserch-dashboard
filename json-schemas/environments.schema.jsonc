{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "patternProperties": {
        "^[a-z](?:[a-z0-9\\-]*[a-z0-9])?$": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "type",
                "description",
                "version",
                "isActive",
                "configuration"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "type": {
                    "type": "string",
                    "enum": ["OPENINTERNET", "UML", "NS3", "MATHEMATICAL"]
                },
                "description": {
                    "type": "string"
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "isActive": {
                    "type": "boolean"
                },
                "configuration": {
                    "type": "object",
                    "additionalProperties": false,
                    "patternProperties": {
                        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}