{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://mptcp-cc-poc/schemas/common.schema.json",
    "title": "Common definitions",
    "description": "Building blocks shared by the mptcp-* document schemas. Not a document type of its own.",
    "$defs": {
        "Id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
            "description": "Stable identifier of a catalogue document: lower case letters, digits, '_', '.', '-'; at most 64 characters; never reused for a different object.",
            "examples": [
                "asym-2path-loss-burst",
                "uml-v0-ref-host1",
                "lia"
            ]
        },
        "Version": {
            "type": "integer",
            "minimum": 1,
            "description": "Version of the document. A saved version is immutable; editing creates version + 1."
        },
        "EnvType": {
            "type": "string",
            "enum": [
                "uml",
                "dce",
                "ns3",
                "rpi4",
                "model"
            ],
            "description": "Environment type: uml = User-Mode Linux emulation with Linux MPTCP v0.96; dce = ns-3 DCE running the Linux 4.1 MPTCP kernel; ns3 = native ns-3 MPTCP model; rpi4 = Raspberry Pi 4 testbed (stage 6, not available yet); model = Python/Octave mathematical model (stage 7, not available yet)."
        },
        "Seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "description": "Seed of one repetition. All random decisions of a run (loss pattern, generated events, cross traffic) are derived from it; the same seed gives the same conditions for every algorithm."
        },
        "Seeds": {
            "description": "How the seeds of the repetitions are chosen.",
            "oneOf": [
                {
                    "title": "Sequence",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "strategy",
                        "start",
                        "step"
                    ],
                    "properties": {
                        "strategy": {
                            "const": "sequence"
                        },
                        "start": {
                            "$ref": "#/$defs/Seed",
                            "description": "Seed of repetition 1."
                        },
                        "step": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1,
                            "description": "Seed of repetition n = start + (n - 1) * step."
                        }
                    }
                },
                {
                    "title": "Explicit list",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "strategy",
                        "values"
                    ],
                    "properties": {
                        "strategy": {
                            "const": "explicit"
                        },
                        "values": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 1000,
                            "uniqueItems": true,
                            "items": {
                                "$ref": "#/$defs/Seed"
                            },
                            "description": "One seed per repetition, in repetition order. Rule S-SEEDS: the length must equal the number of repetitions."
                        }
                    }
                }
            ]
        },
        "Repetitions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Number of repetitions (runs with different seeds) per algorithm and environment."
        },
        "Labels": {
            "type": "object",
            "description": "Free key/value tags for filtering in the UI (e.g. family, stage). Not interpreted by the backend.",
            "propertyNames": {
                "pattern": "^[a-z0-9_.-]{1,32}$"
            },
            "additionalProperties": {
                "type": "string",
                "maxLength": 128
            }
        },
        "Sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "Timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "UTC time, RFC 3339 (e.g. 2026-11-09T12:00:00Z)."
        }
    }
}